# ==========================================================================
# PAYSTACK — template. Copy to .env.local and fill THAT in. No values here.
#
# THIS FILE IS GITIGNORED AND MUST STAY THAT WAY. Confirm any time with:
#     git check-ignore -v .env.local
#
# Keys: dashboard.paystack.com -> Settings -> API Keys & Webhooks
#   pk_…  public, safe in the browser, can only start a payment
#   sk_…  SERVER ONLY. Whoever holds sk_live_ can charge cards, refund, and
#         export your customer list. Never in the browser, git, or a
#         screenshot. If one leaks, roll it in the dashboard immediately.
#
# There is no test/live switch — it is whichever pair of keys is present.
# Test cards: https://paystack.com/docs/payments/test-payments
# ==========================================================================

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Tuition in KOBO — naira times 100, a whole number.  ₦200,000 -> 20000000
PAYSTACK_TUITION_KOBO=
PAYSTACK_CURRENCY=

# The deposit, as a percentage of the total. Nothing CHARGES this — instalments
# are paid by bank transfer — but it is the ₦140,000 / ₦60,000 printed on the
# page. The balance is the subtraction, never the other percentage, so the two
# always add up to exactly the tuition.
PAYSTACK_DEPOSIT_PERCENT=

# NOTE: the bank details and the Tally form URL are NOT here. They are public
# information printed on the page, so they live as BANK and TALLY_URL at the
# top of pay.js — same idiom as FORM_ENDPOINT in script.js.
