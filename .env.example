# ==========================================================================
# THE FILM & CONTENT SCHOOL — env template. Copy to .env.local and fill
# THAT in. No real values in this file, ever.
#
# THIS FILE IS GITIGNORED AND MUST STAY THAT WAY. Confirm any time with:
#     git check-ignore -v .env.local
#
# Copy each value from the dashboard it belongs to. Anything marked SERVER
# ONLY can charge cards, read student records or send mail as you — it must
# never reach the browser, a screenshot, or a chat window. If one leaks, roll
# it in that dashboard immediately.
# ==========================================================================

# --- PAYSTACK -------------------------------------------------------------
# dashboard.paystack.com -> Settings -> API Keys & Webhooks
#   pk_…  public, safe in the browser, can only start a payment
#   sk_…  SERVER ONLY
# There is no test/live switch — it is whichever pair of keys is present.
# Test cards: https://paystack.com/docs/payments/test-payments
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Tuition in KOBO — naira times 100, a whole number.
#   ₦200,000  ->  20000000
PAYSTACK_TUITION_KOBO=
PAYSTACK_CURRENCY=

# The deposit, as a percentage of the total. The balance is the SUBTRACTION,
# never the other percentage, so the two always sum to exactly the tuition —
# see api/_paystack.js. At 70 on ₦200,000: ₦140,000 down, ₦60,000 on
# resumption within the first four weeks.
PAYSTACK_DEPOSIT_PERCENT=

# --- SUPABASE (the payment record) ----------------------------------------
# supabase.com -> your project -> Settings -> API
# Run tools/supabase-schema.sql in the SQL editor first.
#
# REQUIRED FOR THE 70/30 PLAN. Without it there is nowhere to record that
# ₦60,000 is still owed, so the site offers pay-in-full only rather than a
# plan it cannot honour.
#
# Use the SERVICE ROLE key, not the anon key: the schema turns on row level
# security with no policies, so anon can read nothing and service_role
# bypasses it. SERVER ONLY — it reads and writes every student record.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- RESEND (balance reminders) -------------------------------------------
# resend.com -> API Keys.  SERVER ONLY.
#
# Optional. Paystack already emails a receipt for every charge; this sends the
# thing Paystack cannot know — that ₦140,000 was a deposit and ₦60,000 is
# still due. Unset, payments still work and no mail goes out.
#
# MAIL_FROM must be on a domain verified in Resend, or sending fails.
RESEND_API_KEY=
MAIL_FROM=
MAIL_BCC=
