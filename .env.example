# ==========================================================================
# PAYSTACK — template. Copy to .env.local and fill THAT in. No values here.
#
# THIS FILE IS GITIGNORED AND MUST STAY THAT WAY. Confirm any time with:
#     git check-ignore -v .env.local
#
# Keys: dashboard.paystack.com -> Settings -> API Keys & Webhooks
#   pk_…  public, safe in the browser, can only start a payment
#   sk_…  SERVER ONLY. Whoever holds sk_live_ can charge cards, refund, and
#         export your customer list. Never in the browser, git, or a
#         screenshot. If one leaks, roll it in the dashboard immediately.
#
# There is no test/live switch — it is whichever pair of keys is present.
# Test cards: https://paystack.com/docs/payments/test-payments
# ==========================================================================

# --- ACTIVE: LIVE PAIR ---------------------------------------------------
# REAL MONEY. Every payment on this page now charges a real card, and the
# "Test mode" note disappears from the pay section on its own.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- TEST PAIR — PARKED, NOT ACTIVE --------------------------------------
# Swap the two blocks back to test anything against Paystack's test cards.




TALLY_API_KEY=
# THE PRICE IS NOT HERE ANY MORE. Tuition, the currency and the 70/30 split are
# constants in api/_paystack.js — they are public, identical in every
# environment, and printed on the page in three other places, so an env var was
# a fourth source of truth that could disagree with them. The self-test fails
# if they ever do. PAYSTACK_DEPOSIT_PERCENT in particular never reached
# Paystack at all: instalments are a bank transfer, so the only amount the API
# is ever sent is the full tuition.
#
# The bank details and the Tally form URL are likewise not here — they are
# public information printed on the page, and live as BANK and TALLY_URL at the
# top of pay.js.
