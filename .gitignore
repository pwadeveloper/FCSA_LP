.DS_Store
.gstack/

# Media masters — build inputs, not deliverables. The renditions and the
# poster ladder are generated from these by tools/reel-poster.py and the
# ffmpeg lines in README; the masters themselves are tens of megabytes and
# have no business in git history.
assets/media/*.mp4
!assets/media/reel-720.mp4
!assets/media/reel-1080.mp4
assets/media/reel/reel-poster-master.png
# BackgroundLoop.mp4 is caught by the assets/media/*.mp4 rule above — it is
# the 4.9MB HEVC master. tools/background-loop.py regenerates both renditions
# and the poster ladder from it; only those are deliverables.
assets/media/loop/loop-poster-master.png
assets/media/hero-0*.jpg
# Same rule for the rest-state still: tools/section-still.py regenerates the
# derivatives from it, and only those are deliverables.
assets/media/Section2img.png
# Same rule for the three Film Track frames: tools/film-track-bg.py builds the
# derivatives in assets/media/film/ and only those ship. The masters are 4K and
# total 11.6MB.
assets/media/Film Track BG Image.jpg
assets/media/2nd BG image film track.jpg
assets/media/3rd bg image film track.jpg
__pycache__/
# Same rule for the seven Finisher Track frames: tools/finisher-track.py builds
# the derivatives in assets/media/finisher/ and only those ship.
assets/media/finisher track/

# SECRETS. .env.local holds the Paystack keys and must never be committed —
# a leaked sk_live_ key lets anyone charge cards, refund, and read every
# customer record on the account. .env.example is the checked-in template and
# carries placeholders only, never a real value.
.env
.env.local
.env.*.local
# Same rule for the three Content Track clips: tools/content-clips.py builds
# the renditions in assets/media/content/ and only those ship. The masters are
# 1080x1920 HEVC and total 7.3MB.
assets/media/build a network.mp4
assets/media/compintel mini.mp4
assets/media/world gov see ai.mp4
# Same rule for the eight Showcase clips: tools/showcase-clips.py builds the
# renditions and posters in assets/media/showcase/ and only those ship. The
# masters are HEVC and total 20.4MB. (The eight .mp4 files are already caught
# by the assets/media/*.mp4 rule at the top; this note is here so the next
# person looking for them knows where they went and how to rebuild.)
# The closing section's still is the same story — tools/apply-still.py builds
# assets/media/apply/ from it, and the 1920x1440 master is a build input.
assets/media/See you in class.jpg
